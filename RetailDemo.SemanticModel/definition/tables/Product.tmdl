table Product
	lineageTag: ebb026da-19f8-5960-b380-dc7688dca668

	column product_id
		dataType: int64
		formatString: 0
		lineageTag: 2aa90499-e389-53f3-a1e4-67b0078985f0
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = Automatic

	column product_name
		dataType: string
		lineageTag: a1c08d9c-064f-55e1-bc27-4348c46fa8a5
		summarizeBy: none
		sourceColumn: product_name

		annotation SummarizationSetBy = Automatic

	column category
		dataType: string
		lineageTag: ed4f5627-2d1b-5859-8b88-74e61fffedcf
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	column unit_price
		dataType: double
		formatString: #,0.00
		lineageTag: 537ce900-3c15-5964-81af-b16124ebd57c
		summarizeBy: none
		sourceColumn: unit_price

		annotation SummarizationSetBy = Automatic

	column unit_cost
		dataType: double
		formatString: #,0.00
		lineageTag: 785fda68-40e4-59f2-85cd-5704264bdd84
		summarizeBy: none
		sourceColumn: unit_cost

		annotation SummarizationSetBy = Automatic

	partition Product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "products.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"product_id", Int64.Type}, {"product_name", type text}, {"category", type text}, {"unit_price", type number}, {"unit_cost", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

